# Backend (DEVIR.md §2)
VITE_API_URL=https://xoja2a8sx5.execute-api.eu-central-1.amazonaws.com/prod

# Destek sekmesinde gösterilecek iletişim bilgileri (boşsa gizlenir)
VITE_DESTEK_TELEFON=
VITE_DESTEK_EPOSTA=

# Sohbet asistanı ucu (dil modeli; aws/asistan-kur.ps1 kurar). Boşsa ya da uç
# yanıt vermezse yerel motor yanıtlar.
VITE_ASISTAN_YOLU=/de/asistan

# KVKK Aydınlatma Metni'nde görünen veri sorumlusu bilgileri (/gizlilik sayfası).
# Yayından önce doldurun; metinleri bir avukata okutun (src/veri/kvkk.js).
VITE_SIRKET_UNVAN=Dennis Enerji
VITE_SIRKET_ADRES=
VITE_SIRKET_MERSIS=
VITE_KVKK_EPOSTA=

# Anlık bildirimler: aws/hazirlik-kur.ps1 üretip yazar (boşsa bildirim ayarı gizlenir)
VITE_VAPID_GENEL=
