{
  "appId": "com.dennisenerji.musteri",
  "appName": "Dennis Energy",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#000000",
    "contentInset": "never",
    "scheme": "Dennis Energy"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": false
    }
  }
}
